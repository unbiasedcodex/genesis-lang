// Test: struct declared in a module, built from an impl in that module
// The image engine reports "struct ImageBuffer has no field palette" for
// exactly this shape, while the same code at top level compiles.
//
// main never calls into the module: module bodies are type-checked anyway,
// so the literal below is what this test exercises.

mod inner {
    pub struct Holder {
        pub tag: i64,
        pub data: Vec<u8>,
        pub palette: Option<Vec<u32>>, // nested generics as the last field
    }

    impl Holder {
        pub fn new(tag: i64) -> Holder {
            Holder {
                tag: tag,
                data: Vec::new(),
                palette: None,
            }
        }
    }
}

fn main() -> i64 {
    0
}
